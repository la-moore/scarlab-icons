{
    "name": "@scarlab-icons/svelte",
    "version": "4.0.0",
    "description": "A set of free MIT-licensed Svelte components with SVG icons.",
    "repository": "https://github.com/la-moore/scarlab-icons",
    "homepage": "https://scarlab-icons.la-moore.ru",
    "author": "moorlex",
    "license": "MIT",
    "keywords": [
        "icons",
        "svg",
        "svelte"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./base": {
            "types": "./dist/base/index.d.ts",
            "svelte": "./dist/base/index.js",
            "default": "./dist/base/index.js"
        },
        "./base/*": {
            "types": "./dist/base/*.svelte.d.ts",
            "svelte": "./dist/base/*.svelte",
            "default": "./dist/base/*.svelte"
        },
        "./ghost": {
            "types": "./dist/ghost/index.d.ts",
            "svelte": "./dist/ghost/index.js",
            "default": "./dist/ghost/index.js"
        },
        "./ghost/*": {
            "types": "./dist/ghost/*.svelte.d.ts",
            "svelte": "./dist/ghost/*.svelte",
            "default": "./dist/ghost/*.svelte"
        },
        "./outline": {
            "types": "./dist/outline/index.d.ts",
            "svelte": "./dist/outline/index.js",
            "default": "./dist/outline/index.js"
        },
        "./outline/*": {
            "types": "./dist/outline/*.svelte.d.ts",
            "svelte": "./dist/outline/*.svelte",
            "default": "./dist/outline/*.svelte"
        },
        "./solid": {
            "types": "./dist/solid/index.d.ts",
            "svelte": "./dist/solid/index.js",
            "default": "./dist/solid/index.js"
        },
        "./solid/*": {
            "types": "./dist/solid/*.svelte.d.ts",
            "svelte": "./dist/solid/*.svelte",
            "default": "./dist/solid/*.svelte"
        }
    },
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "prebuild": "node ../../scripts/clean.mjs dist",
        "build": "tsx ./scripts/build.ts"
    },
    "devDependencies": {
        "@scarlab-icons/icons": "^4.0.0",
        "@types/node": "^22.19.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "svelte": ">= 3"
    }
}
