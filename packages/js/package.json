        "build": "rollup -c"
    },
    "devDependencies": {
        "@scarlab-icons/icons": "*",
        "@types/node": "^22.19.1",
        "rimraf": "^3.0.2",
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-typescript": "^12.1.4",
        "rollup": "^4.40.0",
        "rollup-plugin-dts": "^6.2.3",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
