{
    "name": "@scarlab-icons/angular",
    "version": "3.0.0",
    "description": "A set of free MIT-licensed Angular components with SVG icons.",
    "repository": "https://github.com/la-moore/scarlab-icons",
    "homepage": "https://scarlab-icons.la-moore.ru",
    "author": "moorlex",
    "license": "MIT",
    "keywords": ["icons", "svg", "angular"],
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        "./base/*": {
            "types": "./dist/base/*.ts",
            "default": "./dist/base/*.ts"
        },
        "./base": {
            "types": "./dist/base/index.ts",
            "default": "./dist/base/index.ts"
        },
        "./ghost/*": {
            "types": "./dist/ghost/*.ts",
            "default": "./dist/ghost/*.ts"
        },
        "./ghost": {
            "types": "./dist/ghost/index.ts",
            "default": "./dist/ghost/index.ts"
        },
        "./outline/*": {
            "types": "./dist/outline/*.ts",
            "default": "./dist/outline/*.ts"
        },
        "./outline": {
            "types": "./dist/outline/index.ts",
            "default": "./dist/outline/index.ts"
        },
        "./solid/*": {
            "types": "./dist/solid/*.ts",
            "default": "./dist/solid/*.ts"
        },
        "./solid": {
            "types": "./dist/solid/index.ts",
            "default": "./dist/solid/index.ts"
        }
    },
    "scripts": {
        "prebuild": "rimraf ./dist",
        "build": "tsx ./scripts/build.ts"
    },
    "devDependencies": {
        "@scarlab-icons/icons": "*",
        "@types/node": "^22.19.1",
        "prettier": "^2.8.7",
        "rimraf": "^3.0.2",
        "svgson": "^5.3.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@angular/common": ">= 16",
        "@angular/core": ">= 16"
    }
}
