{
    "name": "@scarlab-icons/vue",
    "version": "3.1.0",
    "description": "A set of free MIT-licensed Vue components with SVG icons.",
    "repository": "https://github.com/la-moore/scarlab-icons",
    "homepage": "https://scarlab-icons.la-moore.ru",
    "author": "moorlex",
    "license": "MIT",
    "keywords": [
        "icons",
        "svg",
        "vue"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./types": {
            "import": {
                "types": "./dist/types.d.ts"
            },
            "require": {
                "types": "./dist/types.d.cts"
            }
        },
        "./base": {
            "import": {
                "types": "./dist/base/index.d.ts",
                "default": "./dist/base/index.js"
            },
            "require": {
                "types": "./dist/base/index.d.cts",
                "default": "./dist/base/index.cjs"
            }
        },
        "./base/*": {
            "import": {
                "types": "./dist/base/*.d.ts",
                "default": "./dist/base/*.js"
            },
            "require": {
                "types": "./dist/base/*.d.cts",
                "default": "./dist/base/*.cjs"
            }
        },
        "./ghost": {
            "import": {
                "types": "./dist/ghost/index.d.ts",
                "default": "./dist/ghost/index.js"
            },
            "require": {
                "types": "./dist/ghost/index.d.cts",
                "default": "./dist/ghost/index.cjs"
            }
        },
        "./ghost/*": {
            "import": {
                "types": "./dist/ghost/*.d.ts",
                "default": "./dist/ghost/*.js"
            },
            "require": {
                "types": "./dist/ghost/*.d.cts",
                "default": "./dist/ghost/*.cjs"
            }
        },
        "./outline": {
            "import": {
                "types": "./dist/outline/index.d.ts",
                "default": "./dist/outline/index.js"
            },
            "require": {
                "types": "./dist/outline/index.d.cts",
                "default": "./dist/outline/index.cjs"
            }
        },
        "./outline/*": {
            "import": {
                "types": "./dist/outline/*.d.ts",
                "default": "./dist/outline/*.js"
            },
            "require": {
                "types": "./dist/outline/*.d.cts",
                "default": "./dist/outline/*.cjs"
            }
        },
        "./solid": {
            "import": {
                "types": "./dist/solid/index.d.ts",
                "default": "./dist/solid/index.js"
            },
            "require": {
                "types": "./dist/solid/index.d.cts",
                "default": "./dist/solid/index.cjs"
            }
        },
        "./solid/*": {
            "import": {
                "types": "./dist/solid/*.d.ts",
                "default": "./dist/solid/*.js"
            },
            "require": {
                "types": "./dist/solid/*.d.cts",
                "default": "./dist/solid/*.cjs"
            }
        }
    },
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "prebuild": "node ../../scripts/clean.mjs dist",
        "build": "tsx ./scripts/build.ts"
    },
    "devDependencies": {
        "@scarlab-icons/icons": "^3.1.0",
        "@types/node": "^22.19.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "vue": ">= 3"
    }
}
