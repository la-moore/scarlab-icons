{
    "name": "@scarlab-icons/react",
    "version": "3.0.0",
    "description": "A set of free MIT-licensed React components with SVG icons.",
    "repository": "https://github.com/la-moore/scarlab-icons",
    "homepage": "https://scarlab-icons.la-moore.ru",
    "author": "moorlex",
    "license": "MIT",
    "keywords": ["icons", "svg", "react"],
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        "./base": {
            "types": "./dist/base/index.ts",
            "import": "./dist/base/index.js",
            "require": "./dist/base/index.cjs"
        },
        "./base/*": {
            "types": "./dist/base/*.ts",
            "import": "./dist/base/*.js",
            "require": "./dist/base/*.cjs"
        },
        "./ghost": {
            "types": "./dist/ghost/index.ts",
            "import": "./dist/ghost/index.js",
            "require": "./dist/ghost/index.cjs"
        },
        "./ghost/*": {
            "types": "./dist/ghost/*.ts",
            "import": "./dist/ghost/*.js",
            "require": "./dist/ghost/*.cjs"
        },
        "./solid": {
            "types": "./dist/solid/index.ts",
            "import": "./dist/solid/index.js",
            "require": "./dist/solid/index.cjs"
        },
        "./solid/*": {
            "types": "./dist/solid/*.ts",
            "import": "./dist/solid/*.js",
            "require": "./dist/solid/*.cjs"
        },
        "./outline": {
            "types": "./dist/outline/index.ts",
            "import": "./dist/outline/index.js",
            "require": "./dist/outline/index.cjs"
        },
        "./outline/*": {
            "types": "./dist/outline/*.ts",
            "import": "./dist/outline/*.js",
            "require": "./dist/outline/*.cjs"
        }
    },
    "scripts": {
        "prebuild": "rimraf ./dist",
        "build": "tsx ./scripts/build.ts"
    },
    "devDependencies": {
        "@scarlab-icons/icons": "*",
        "@types/node": "^22.19.1",
        "@types/react": "^19.0.0",
        "prettier": "^2.8.7",
        "rimraf": "^3.0.2",
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-typescript": "^12.1.4",
        "rollup": "^4.40.0",
        "rollup-plugin-dts": "^6.2.3",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "svgson": "^5.3.1"
    },
    "peerDependencies": {
        "react": ">= 17"
    }
}
