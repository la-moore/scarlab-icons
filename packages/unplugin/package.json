{
    "name": "@scarlab-icons/unplugin",
    "version": "3.2.0",
    "description": "Build-time plugin for Scarlab Icons: bundles only the icons your project uses and inlines static ones into HTML.",
    "repository": "https://github.com/la-moore/scarlab-icons",
    "homepage": "https://scarlab-icons.la-moore.ru",
    "author": "moorlex",
    "license": "MIT",
    "keywords": [
        "icons",
        "svg",
        "unplugin",
        "vite-plugin",
        "rollup-plugin"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./rollup": {
            "types": "./dist/rollup.d.ts",
            "default": "./dist/rollup.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "node ../../scripts/clean.mjs dist",
        "build": "rollup -c"
    },
    "peerDependencies": {
        "@scarlab-icons/icons": "^3.1.0",
        "@scarlab-icons/js": "^3.2.0"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.1",
        "@types/node": "^22.20.5",
        "rollup": "^4.68.5",
        "rollup-plugin-dts": "^6.5.1",
        "tslib": "^2.9.1",
        "typescript": "^5.9.3",
        "vite": "^8.3.8"
    },
    "dependencies": {
        "tinyglobby": "^0.2.17",
        "unplugin": "^3.7.0"
    },
    "engines": {
        "node": ">=20.19"
    }
}
