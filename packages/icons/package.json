{
    "name": "@scarlab-icons/icons",
    "version": "4.0.0",
    "description": "A set of free MIT-licensed high-quality SVG icons for UI development.",
    "repository": "https://github.com/la-moore/scarlab-icons",
    "homepage": "https://scarlab-icons.la-moore.ru",
    "author": "moorlex",
    "license": "MIT",
    "keywords": [
        "icons",
        "svg"
    ],
    "main": "./index.cjs",
    "module": "./index.js",
    "types": "./index.d.ts",
    "type": "module",
    "files": [
        "base/",
        "ghost/",
        "outline/",
        "solid/",
        "index.d.ts",
        "index.cjs",
        "index.js",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "require": "./index.cjs"
        },
        "./base/*.svg": "./base/*.svg",
        "./ghost/*.svg": "./ghost/*.svg",
        "./outline/*.svg": "./outline/*.svg",
        "./solid/*.svg": "./solid/*.svg",
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "node ../../scripts/clean.mjs base ghost outline solid",
        "build": "tsx ./scripts/index.ts"
    },
    "devDependencies": {
        "@types/node": "^22.19.1",
        "svgo": "^4.0.0",
        "svgson": "^5.3.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
